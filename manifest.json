{
  "manifest_version": 3,
  "name": "PennyPilot — Tax & Bill Deadline Reminders",
  "version": "1.0.0",
  "description": "Add your own U.S. tax & bill deadline reminders by state and ZIP — no auto-import. Private: no account, no tracking.",
  "permissions": ["alarms", "notifications", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PennyPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
